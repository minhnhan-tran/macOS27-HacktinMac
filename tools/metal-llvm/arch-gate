#!/usr/bin/env python3.14
"""Check that an LLVM tool directory works on this Mac, even under Rosetta."""
import os
import subprocess
import sys
from pathlib import Path

bin_dir = Path(sys.argv[1]) if len(sys.argv) > 1 else Path(__file__).resolve().parent / 'payload'
ir = '; ModuleID = "gate"\ntarget triple = "air64_v24-apple-macosx14.0.0"\ndefine void @f() { ret void }\n'
for name in ('llvm-as', 'llvm-dis', 'opt'):
    if not (bin_dir / name).is_file():
        raise SystemExit('missing ' + name)
bc = subprocess.run([str(bin_dir / 'llvm-as'), '-', '-o', '-'], input=ir.encode(), capture_output=True, check=True).stdout
opt = subprocess.run([str(bin_dir / 'opt'), '-passes=instcombine', '-', '-o', '-'], input=bc, capture_output=True, check=True).stdout
out = subprocess.run([str(bin_dir / 'llvm-dis'), '-', '-o', '-'], input=opt, capture_output=True, check=True).stdout.decode()
if 'define void @f()' not in out:
    raise SystemExit('unexpected llvm-dis output')
if (bin_dir / 'assemble').is_file() and os.uname().machine == 'x86_64':
    subprocess.run([str(bin_dir / 'assemble')], input=b'', capture_output=True)
print('ok', bin_dir)
