#!/usr/bin/env python3
"""Build one release asset of m27-patcher from this checkout and compare it with its input row.

  asset-build list
  asset-build ROW OUT [--m27-runtime CHECKOUT] [--oclp-upstream URL_OR_CLONE]

Writes the asset to OUT (a new folder; a file asset is OUT/NAME), then prints `SHA256 ROW` with the sha256 the row
defines (pipeline/lock.py, so a `# hash:` line applies) and exits 1 when it is not the row's. Needs Xcode
(xcrun clang, codesign). codeid_carrier also needs a clean macos27tool-runtime checkout at the commit below; oclp_source
clones upstream OCLP from GitHub unless --oclp-upstream names a clone.
"""
import argparse
import glob
import json
import os
from pathlib import Path
import runpy
import shutil
import subprocess
import sys
import tempfile

TOP = Path(__file__).resolve().parents[2]
LOCKS = ('pipeline/inputs/golden/26B131', 'pipeline/inputs/25G342', 'pipeline/inputs/common')
M27_RUNTIME_CODEID = '33a0a0404d3f5c3008c79e295026ea99bee563eb'
PY = [sys.executable, '-I']
NOT_COMPARED = 3     # built, but nothing here to compare it with (a made-on-Mac row without the store)


def run(*args):
    subprocess.run([str(a) for a in args], cwd=TOP, check=True, stdout=subprocess.DEVNULL)


def one(pattern):
    found = glob.glob(str(pattern))
    if len(found) != 1:
        sys.exit('asset-build: expected one %s, found %d' % (pattern, len(found)))
    return Path(found[0])


def compiled(make):
    """A Wi-Fi compat library: the make's own build() (compile and sign); its coverage pass needs Apple files."""
    def build(tmp, out, args):
        return runpy.run_path(str(TOP/make))['build'](tmp)
    return build


def made(make, pattern):
    """A producer that writes PARENT/<name>-.../FILE."""
    def build(tmp, out, args):
        run(*PY, make, tmp)
        return one(Path(tmp)/pattern)
    return build


def dss(tmp, out, args):
    run(*PY, 'tools/display-state-shim/display-state-shim', '--out', Path(tmp)/'a')
    return Path(tmp)/'a/dss_shim.dylib'


def slice_guard(tmp, out, args):
    run(*PY, 'patches/golden-gate-appstore-slices/build/make', tmp)
    out.mkdir()
    shutil.copy(one(Path(tmp)/'appstore-slices-*/m27-slice-guard'), out/'m27-slice-guard')
    return out


def hd4000(tmp, out, args):
    run(*PY, 'patches/golden-gate-hd4000-planes/build/make', tmp)
    out.mkdir()
    shutil.copy(one(Path(tmp)/'hd4000-planes-*/libhd4000-planes.dylib'), out/'libhd4000-planes.dylib')
    return out


def store(tmp, out, args):
    out.mkdir()
    runpy.run_path(str(TOP/'tools/appstore-policy/prepare.py'))['compile_library'](out/'libm27-appstore-policy.dylib')
    return out


def codeid(tmp, out, args):
    if not args.m27_runtime:
        sys.exit('asset-build: codeid_carrier needs --m27-runtime CHECKOUT (macos27tool-runtime %s)' % M27_RUNTIME_CODEID)
    head = subprocess.run(['git', '-C', str(args.m27_runtime), 'rev-parse', 'HEAD'], capture_output=True, text=True)
    if head.stdout.strip() != M27_RUNTIME_CODEID:
        sys.exit('asset-build: %s is not macos27tool-runtime %s' % (args.m27_runtime, M27_RUNTIME_CODEID))
    run(*PY, 'patches/golden-gate-userspace/src/codeid/make', tmp, '--m27-runtime', args.m27_runtime)
    shutil.copytree(one(Path(tmp)/'codeid-carrier-*'), out)
    return out


def helloblur(tmp, out, args):
    run('sh', 'patches/golden-gate-hello/build/make.sh', tmp)
    return Path(tmp)/'libhelloblur.dylib'



def selectors(tmp, out, args):
    run(*PY, 'patches/metalold-selectors/build/make', tmp)
    out.mkdir()
    shutil.copy(one(Path(tmp)/'metalold-selectors-*/libmetalold-selectors.dylib'), out/'libmetalold-selectors.dylib')
    return out


def framebuffer(tmp, out, args):
    run(*PY, 'patches/golden-gate-metal-framebuffer/build/metal-framebuffer', 'build', Path(tmp)/'fb')
    out.mkdir()
    shutil.copy(Path(tmp)/'fb/libmetal-framebuffer.dylib', out/'libmetal-framebuffer.dylib')
    return out


# The wrapper re-exports Apple's iCBE but imports nothing from it: linking against an empty stub with that library's
# install name and versions gives the same iCBE.dylib. iCBE-real.dylib itself is made on the Mac (release-classes.json).
ICBE_NAME = '/Library/Caches/com.apple.xbs/Binaries/GPUDriversIntel/install/Symbols/Release-ivb/iCBE.dylib'


def argbuf(tmp, out, args):
    stub = Path(tmp)/'stub'
    stub.mkdir()
    (stub/'empty.c').write_text('\n')
    run('xcrun', 'clang', '-arch', 'x86_64', '-mmacosx-version-min=11.7', '-dynamiclib', stub/'empty.c', '-install_name',
        ICBE_NAME, '-current_version', '0', '-compatibility_version', '0', '-o', stub/'iCBE.dylib')
    run('tools/metal-argbuf/make', Path(tmp)/'a', '--icbe', stub/'iCBE.dylib')
    out.mkdir()
    for n in ('iCBE.dylib', 'libargbuf.dylib'):
        shutil.copy(Path(tmp)/'a'/n, out/n)
    return out


def live_text(sub):
    """tools/live-text build from the Apple inputs folder `live-text inputs` makes (--live-text-inputs)."""
    def build(tmp, out, args):
        if not args.live_text_inputs:
            sys.exit('asset-build: %s needs --live-text-inputs DIR (tools/live-text/live-text inputs)' % sub)
        blur = Path(tmp)/'blur'
        run('sh', 'patches/golden-gate-hello/build/make.sh', blur)
        run(*PY, 'tools/live-text/live-text', 'build', '--inputs', args.live_text_inputs, '--startup-library',
            blur/'libhelloblur.dylib', '--output', Path(tmp)/'lt')
        shutil.copytree(Path(tmp)/'lt'/sub, out, symlinks=True)
        return out
    return build


def tool(*argv, name):
    """A pipeline/unpack producer that writes NEW_DIR/NAME and its build.json."""
    def build(tmp, out, args):
        extra = ['--upstream', args.oclp_upstream] if args.oclp_upstream and argv[-1] == 'oclp-source-rebuild' else []
        run(*PY, *argv, Path(tmp)/'a', *extra)
        return Path(tmp)/'a'/name
    return build


ASSETS = {
    'display_state_shim': dss,
    'io80211_compat': compiled('patches/golden-gate-userspace/src/io80211/make'),
    'wifip2p_compat': compiled('patches/golden-gate-userspace/src/wifip2p/make'),
    'corewifi_compat': compiled('patches/golden-gate-userspace/src/corewifi/make'),
    'windowserver_filter_shim': made('patches/golden-gate-windowserver-filter/make',
                                     'windowserver-filter-*/windowserver_filter.dylib'),
    'corespotlight_compat_shim': made('patches/golden-gate-corespotlight-compat/make',
                                      'corespotlight-compat-*/corespotlight_compat.dylib'),
    'codeid_carrier': codeid,
    'store_service': store,
    'appstore_slice_guard': slice_guard,
    'fl': tool('pipeline/unpack/pristine-tools/build-fl', name='fl'),
    'ripatch': tool('pipeline/unpack/build-tools', 'ripatch', name='ripatch'),
    'oclp_source': tool('pipeline/unpack/build-tools', 'oclp-source-rebuild', name='oclp-source.tar'),
    'hd4000_planes': hd4000,
    'libhelloblur': helloblur,
    'metalold_selectors': selectors,
    'metal_framebuffer': framebuffer,
    'metal_argbuf': argbuf,
    'metal_compiler_compat': live_text('compiler-service'),
    'live_text_framework': live_text('framework'),
}


def lock_of(row):
    for lock in LOCKS:
        if (TOP/lock/row).is_file():
            return str(TOP/lock)
    sys.exit('asset-build: no row %s in %s' % (row, ', '.join(LOCKS)))


def main(argv=None):
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument('row')
    p.add_argument('out', type=Path, nargs='?')
    p.add_argument('--m27-runtime', type=Path)
    p.add_argument('--oclp-upstream', help='oclp_source: an OCLP clone or URL instead of GitHub')
    p.add_argument('--live-text-inputs', type=Path, help='metal_compiler_compat, live_text_framework: the folder `tools/live-text/live-text inputs` made')
    args = p.parse_args(argv)
    if args.row == 'list':
        print('\n'.join(ASSETS))
        return 0
    if args.row not in ASSETS or args.out is None:
        p.error('ROW is one of: %s; OUT is required' % ', '.join(ASSETS))
    out = args.out.resolve()
    if out.exists():
        p.error('%s exists' % out)
    lock = lock_of(args.row)
    L = runpy.run_path(str(TOP/'pipeline/lock.py'))
    want, path = L['rows'](lock)[args.row]
    with tempfile.TemporaryDirectory(prefix='asset-build-') as tmp:
        built = ASSETS[args.row](tmp, out, args)
        if built != out:
            out.mkdir(parents=True)
            shutil.copyfile(built, out/os.path.basename(path))
            built = out/os.path.basename(path)
    entry = json.load(open(TOP/'pipeline/release-classes.json'))['rows'].get(args.row) or {}
    if entry.get('made_on_mac_files'):
        # The row's hash also covers files a user's Mac makes from Apple's (not built here): compare the published
        # files with the row's copies when the store has them; otherwise the release asset is the comparison.
        names = entry['include']
        mine = {n: L['sha256'](str(built/n)) for n in names}
        for n in names:
            print('%s %s/%s' % (mine[n], args.row, n))
        path = str(TOP/path)
        if not os.path.isdir(path):
            print('asset-build: %s: built, not compared (made-on-Mac files and no store copy here); compare the release '
                  'asset' % args.row, file=sys.stderr)
            return NOT_COMPARED
        bad = [n for n in names if L['sha256'](os.path.join(path, n)) != mine[n]]
        for n in bad:
            print('asset-build: %s/%s differs from the row\'s copy' % (args.row, n), file=sys.stderr)
        return 1 if bad else 0
    got = L['row_hash'](lock, args.row, str(built))
    print('%s %s' % (got, args.row))
    if got != want:
        print('asset-build: %s is %s, the row says %s' % (args.row, got, want), file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
