#!/usr/bin/env python3
"""stub-edit: edit the x86_64 stub m27-install generated for a program, and refresh its stub identity.

  stub-edit SYSTEM SPEC [--record FILE] [--target-data FILE]

For a recipe's kc-hook that runs after macos27tool-runtime in the set: SPEC is an edit spec (format 1) whose `path` is a
program of SYSTEM listed in SYSTEM/usr/lib/m27/stub-identities, whose `arch` is x86_64 and whose `origin.kind` is
`m27`. In one pass, refusing before anything is written when a check fails:

  1. Lineage. The program's x86_64 CDHash is the stub CDHash its stub-identities line records (the stub this
     image's m27-install embedded, not a copy from another payload), and its Apple arm64 slice has the line's
     Apple CDHash. Exactly one line names the program.
  2. The x86_64 slice alone is cut out, SPEC's edits are applied (tools/edit-engine) and it is signed as SPEC's
     `sign` says. The stub binds its bundle (code-signature special slots -1 Info.plist and -3 resources); codesign
     on a lone slice cannot compute them, so the stub's own values are carried into the new CodeDirectory.
  3. The new slice replaces the old one; every other slice is kept byte for byte (checked), and the file is written
     in place (same inode, owner, mode and flags).
  4. The program's stub-identities line gets the new stub CDHash; every other line is unchanged.

A SPEC with when_target is applied only when the target's platform_data (--target-data, by default the file the
hook gets in M27_TARGET_DATA) has that key; otherwise nothing is written and it is reported skipped (exit 0).
--record writes what was done (input and output sha256 and CDHashes, the spec's sha256, the edit record). Exit 0
edited, 1 refused, 2 usage. The hook runs in the builder VM against the offline System (macOS codesign).
"""
import argparse
import hashlib
import json
import os
from pathlib import Path
import struct
import sys

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE / 'src'))
import engine   # noqa: E402
import signing   # noqa: E402
import spec as S   # noqa: E402

STUBS = 'usr/lib/m27/stub-identities'
CPU_X86_64 = 0x01000007


class Refused(Exception):
    pass


def sha256(data):
    return hashlib.sha256(data).hexdigest()


def fat_slices(data):
    """[(cpu, subtype, align, bytes)] of a universal file, in table order."""
    magic, count = struct.unpack_from('>II', data)
    if magic not in (0xcafebabe, 0xcafebabf) or not 0 < count <= 64:
        raise Refused('not a universal Mach-O (a stub is a slice next to Apple\'s)')
    wide, out = magic == 0xcafebabf, []
    for i in range(count):
        at = 8 + i * (32 if wide else 20)
        cpu, sub = struct.unpack_from('>II', data, at)
        if wide:
            start, length, align = struct.unpack_from('>QQI', data, at + 8)
        else:
            start, length, align = struct.unpack_from('>III', data, at + 8)
        if start + length > len(data):
            raise Refused('universal slice past the end of the file')
        out.append((cpu, sub, align, data[start:start + length]))
    return out, wide


def fat_join(parts, wide):
    """A universal file of PARTS [(cpu, subtype, align, bytes)], each at the next offset its alignment allows."""
    entry = 32 if wide else 20
    at = 8 + entry * len(parts)
    table, body = bytearray(struct.pack('>II', 0xcafebabf if wide else 0xcafebabe, len(parts))), []
    for cpu, sub, align, blob in parts:
        start = -(-at // (1 << align)) * (1 << align)
        body.append((start, blob))
        table += struct.pack('>IIQQII', cpu, sub, start, len(blob), align, 0) if wide else \
            struct.pack('>IIIII', cpu, sub, start, len(blob), align)
        at = start + len(blob)
    out = bytearray(at)
    out[:len(table)] = table
    for start, blob in body:
        out[start:start + len(blob)] = blob
    return bytes(out)


def code_directories(data):
    """{hash type: CodeDirectory offset} of a thin Mach-O's embedded signature."""
    if data[:4] != b'\xcf\xfa\xed\xfe':
        raise Refused('expected a thin 64-bit Mach-O')
    at = 32
    for _ in range(struct.unpack_from('<I', data, 16)[0]):
        cmd, size = struct.unpack_from('<II', data, at)
        if size < 8 or at + size > len(data):
            raise Refused('invalid load command')
        if cmd == 0x1d:
            start, length = struct.unpack_from('<II', data, at + 8)
            magic, total, count = struct.unpack_from('>III', data, start)
            if magic != 0xfade0cc0 or total > length or start + length > len(data):
                raise Refused('invalid embedded signature')
            out = {}
            for i in range(count):
                slot, offset = struct.unpack_from('>II', data, start + 12 + 8 * i)
                if slot == 0 or 0x1000 <= slot < 0x1006:
                    cd = start + offset
                    if struct.unpack_from('>I', data, cd)[0] != 0xfade0c02:
                        raise Refused('invalid CodeDirectory')
                    out[data[cd + 37]] = cd
            return out
        at += size
    raise Refused('the slice is not signed')


def carry_bundle_slots(original, edited):
    """EDITED with ORIGINAL's special slots -1 (Info.plist) and -3 (resources) in each of its CodeDirectories."""
    target = bytearray(edited)
    old, new = code_directories(original), code_directories(target)
    for kind, before in old.items():
        p_hash, p_count = struct.unpack_from('>I', original, before + 16)[0], struct.unpack_from('>I', original, before + 24)[0]
        size = original[before + 36]
        for slot in (1, 3):
            value = original[before + p_hash - slot * size:before + p_hash - (slot - 1) * size] if slot <= p_count else b''
            if not any(value):
                continue
            cd = new.get(kind)
            if cd is None or not struct.unpack_from('>I', target, cd + 12)[0] & 2:   # CS_ADHOC
                raise Refused('the new signature cannot carry the bundle slot (not ad hoc, or no such hash type)')
            t_hash, t_count = struct.unpack_from('>I', target, cd + 16)[0], struct.unpack_from('>I', target, cd + 24)[0]
            if target[cd + 36] != size or slot > t_count:
                raise Refused('the new CodeDirectory has no room for bundle slot -%d' % slot)
            begin = cd + t_hash - slot * size
            target[begin:begin + size] = value
    return bytes(target)


def cdhashes(data):
    return {name: (cd or {}).get('cdhash') for name, cd in signing.read(data).items()}


def stub_line(lines, path):
    hits = [i for i, l in enumerate(lines) if not l.startswith('#') and len(l.split(None, 3)) == 4
            and l.split(None, 3)[3] == path]
    if len(hits) != 1:
        raise Refused('%s: %d stub-identities lines name it (expected 1)' % (path, len(hits)))
    return hits[0]


def write_in_place(target, data):
    with open(target, 'r+b') as f:
        f.truncate(0)
        f.write(data)


def edit_x86_slice(spec, data, path):
    """DATA (universal) with its one x86_64 slice edited and signed as SPEC says, bundle slots carried; every other
    slice checked unchanged. Returns (output, index of the x86_64 slice, its name, the parts, the edit record)."""
    parts, wide = fat_slices(data)
    x86 = [i for i, p in enumerate(parts) if p[0] == CPU_X86_64]
    if len(x86) != 1:
        raise Refused('%s: %d x86_64 slices (expected exactly one)' % (path, len(x86)))
    i = x86[0]
    thin = parts[i][3]
    try:
        edited, record = engine.apply(spec, thin, repo=str(HERE.parents[1]))
    except engine.EditError as x:
        raise Refused('edit refused: %s' % x)
    if not spec.get('sign'):
        raise Refused('the spec must sign the edited slice')
    try:
        edited = signing.sign(edited, spec['sign'], thin, None, S.codesign_args)
    except signing.SignatureError as x:
        raise Refused(str(x))
    edited = carry_bundle_slots(thin, edited)
    new_parts = list(parts)
    cpu, sub, align, _ = parts[i]
    new_parts[i] = (cpu, sub, align, edited)
    out = fat_join(new_parts, wide)
    check, _ = fat_slices(out)
    for j, (a, b) in enumerate(zip(parts, check)):
        if j != i and a[3] != b[3]:
            raise Refused('%s: slice %d changed (only the x86_64 slice may)' % (path, j))
    return out, i, signing.slice_name(cpu, sub), parts, record


def native_edit(spec, spec_path, path, target, data, record_path):
    """An Apple universal program: its lineage is its sha256, which must be a key of SPEC's `expect`; the x86_64
    slice is edited and signed as for a stub; no stub-identities line (golden-gate-native-identities lists it)."""
    expect = spec.get('expect') or {}
    before = sha256(data)
    if before not in expect:
        raise Refused('%s: sha256 %s is not an input the spec\'s expect lists (%s)'
                      % (path, before[:12], ', '.join(k[:12] for k in expect) or 'none'))
    out, i, name, parts, record = edit_x86_slice(spec, data, path)
    write_in_place(target, out)
    after = sha256(out)
    result = {'path': path, 'kind': 'apple', 'spec_sha256': sha256(Path(spec_path).read_bytes()),
              'before': {'sha256': before}, 'after': {'sha256': after, 'cdhash': cdhashes(out)[name]},
              'expected_sha256': expect[before], 'as_expected': after == expect[before],
              'kept_slices': {signing.slice_name(c, s_): sha256(b) for j, (c, s_, _, b) in enumerate(parts) if j != i},
              'edits': record}
    if record_path:
        Path(record_path).write_text(json.dumps(result, indent=1) + '\n')
    return result


def stub_edit(system, spec_path, record_path=None, target_data=None):
    """TARGET_DATA: the file holding the target's platform_data (read only for a spec with when_target)."""
    system = Path(system)
    spec = S.load(str(spec_path))
    if 'when_target' in spec:
        skip = S.target_skip(spec, S.load_platform_data(target_data))
        if skip:
            result = {'path': spec.get('path'), 'skipped': skip, 'when_target': spec['when_target'],
                      'spec_sha256': sha256(Path(spec_path).read_bytes())}
            if record_path:
                Path(record_path).write_text(json.dumps(result, indent=1) + '\n')
            return result
    path = spec.get('path', '')
    kind = (spec.get('origin') or {}).get('kind')
    if spec.get('arch') != 'x86_64' or kind not in ('m27', 'apple'):
        raise Refused('the spec must say arch x86_64 and origin kind m27 (a stub m27 generated) or apple')
    if not path or path.startswith('/') or '..' in Path(path).parts:
        raise Refused('the spec path must be relative to the System root')
    target, stubs = system / path, system / STUBS
    if target.is_symlink() or not target.is_file():
        raise Refused('%s is not a file' % path)
    data = target.read_bytes()
    if kind == 'apple':
        return native_edit(spec, spec_path, path, target, data, record_path)
    lines = stubs.read_text().splitlines()
    at = stub_line(lines, path)
    stub_cd, apple_cd, arch = lines[at].split(None, 3)[:3]
    parts, wide = fat_slices(data)
    names = {signing.slice_name(cpu, sub): i for i, (cpu, sub, _, _) in enumerate(parts)}
    seen = cdhashes(data)
    x86 = [i for i, p in enumerate(parts) if p[0] == CPU_X86_64]
    if len(x86) != 1:
        raise Refused('%s: %d x86_64 slices (a stub is exactly one)' % (path, len(x86)))
    x86_name = signing.slice_name(parts[x86[0]][0], parts[x86[0]][1])
    if seen.get(x86_name) != stub_cd:
        raise Refused('%s: x86_64 CDHash %s is not the stub-identities stub %s (not the stub this image embedded)'
                      % (path, seen.get(x86_name), stub_cd))
    if arch not in names or seen.get(arch) != apple_cd:
        raise Refused('%s: %s CDHash %s is not Apple\'s %s from stub-identities' % (path, arch, seen.get(arch), apple_cd))
    thin = parts[x86[0]][3]
    try:
        edited, record = engine.apply(spec, thin, repo=str(HERE.parents[1]))
    except engine.EditError as x:
        raise Refused('edit refused: %s' % x)
    if not spec.get('sign'):
        raise Refused('the spec must sign the edited stub')
    try:
        edited = signing.sign(edited, spec['sign'], thin, None, S.codesign_args)
    except signing.SignatureError as x:
        raise Refused(str(x))
    edited = carry_bundle_slots(thin, edited)
    new_parts = list(parts)
    cpu, sub, align, _ = parts[x86[0]]
    new_parts[x86[0]] = (cpu, sub, align, edited)
    out = fat_join(new_parts, wide)
    check, _ = fat_slices(out)
    for i, (a, b) in enumerate(zip(parts, check)):
        if i != x86[0] and a[3] != b[3]:
            raise Refused('%s: slice %d changed (only the x86_64 stub may)' % (path, i))
    after = cdhashes(out)[x86_name]
    lines[at] = '  '.join([after, apple_cd, arch, path])
    write_in_place(target, out)
    write_in_place(stubs, ('\n'.join(lines) + '\n').encode())
    result = {'path': path, 'spec_sha256': sha256(Path(spec_path).read_bytes()),
              'before': {'sha256': sha256(data), 'stub_cdhash': stub_cd},
              'after': {'sha256': sha256(out), 'stub_cdhash': after},
              'apple': {'arch': arch, 'cdhash': apple_cd},
              'kept_slices': {signing.slice_name(c, s): sha256(b) for i, (c, s, _, b) in enumerate(parts) if i != x86[0]},
              'edits': record}
    if record_path:
        Path(record_path).write_text(json.dumps(result, indent=1) + '\n')
    return result


def main():
    p = argparse.ArgumentParser(description=__doc__.split('\n')[0])
    p.add_argument('system')
    p.add_argument('spec')
    p.add_argument('--record')
    p.add_argument('--target-data', default=os.environ.get('M27_TARGET_DATA'),
                   help='the target\'s platform_data (default $M27_TARGET_DATA)')
    a = p.parse_args()
    try:
        r = stub_edit(a.system, a.spec, a.record, a.target_data)
    except (Refused, OSError, ValueError) as x:
        print('stub-edit: refused: %s' % x, file=sys.stderr)
        return 1
    if r.get('skipped'):
        print('stub-edit: %s: skipped: %s (when_target %s)' % (r['path'], r['skipped'], r['when_target']))
        return 0
    if r.get('kind') == 'apple':
        print('stub-edit: %s: %s -> %s (%s); other slices unchanged' % (
            r['path'], r['before']['sha256'][:12], r['after']['sha256'][:12],
            'as the spec expects' if r['as_expected'] else 'the spec expects %s: signature padding differs on this Mac'
            % r['expected_sha256'][:12]))
    else:
        print('stub-edit: %s: stub %s -> %s; other slices unchanged; stub-identities updated'
              % (r['path'], r['before']['stub_cdhash'][:12], r['after']['stub_cdhash'][:12]))
    return 0


if __name__ == '__main__':
    sys.exit(main())
