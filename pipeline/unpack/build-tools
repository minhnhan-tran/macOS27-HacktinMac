#!/usr/bin/env python3.14
"""build-tools: the helper tools a user's Mac needs to make its rows, built once here and published as our assets, so
the user's Mac needs no compiler and no git checkout (VM-free primary build, step 1).

  build-tools ripatch NEW_DIR                       NEW_DIR/ripatch: pipeline/unpack/ripatch.c as one universal
                                                    (arm64 + x86_64) binary, signed ad hoc; donor-inputs --ripatch uses it
  build-tools oclp-source NEW_DIR --commit C [--repo R]
                                                    NEW_DIR/oclp-source.tar: `git archive` of OpenCore Legacy Patcher at
                                                    C (default repository: store/oclp), with its LICENSE.txt beside it
                                                    (BSD 3-clause); the builder reads OCLP's support code from it
  build-tools oclp-source-rebuild NEW_DIR [--upstream URL_OR_CLONE]
                                                    the same two files without the pinned repository: upstream OCLP
                                                    (default github.com/dortania) at 3.0.0-rc.5 plus
                                                    tools/oclp-integration/target.patch, archived as fd83bda09

Each NEW_DIR gets build.json: the producing m27-patcher commit and whether the checkout was clean, the inputs' sha256,
and the tool versions. Run from a clean checkout for a release (release-cut refuses a dirty record).
"""
import datetime
import hashlib
import json
import os
import runpy
import subprocess
import sys
import tempfile
from pathlib import Path

TOP = Path(__file__).resolve().parents[2]
# the committer time of OCLP fd83bda09 (tools/oclp-integration ORIGINAL): git archive stamps each entry with it
ORIGINAL_TIME = '1793389707 -0400'


def sha256(p):
    h = hashlib.sha256()
    with open(p, 'rb') as f:
        for b in iter(lambda: f.read(1 << 20), b''):
            h.update(b)
    return h.hexdigest()


def source():
    """The producing commit (a checkout's HEAD, or a release archive's pipeline/SOURCE_COMMIT) and whether tracked files
    differ from it; a release archive is clean by construction."""
    commit = runpy.run_path(str(TOP / 'pipeline' / 'source_commit.py'))['commit'](TOP)
    dirty = (TOP / '.git').exists() and bool(subprocess.run(
        ['git', '-c', 'safe.directory=%s' % TOP, '-C', str(TOP), 'status', '--porcelain', '--untracked-files=no'],
        capture_output=True, text=True,
        check=True).stdout.strip())
    return commit, dirty


def new_dir(path):
    path = Path(path)
    path.mkdir(parents=True)          # new: an artifact folder is never written over
    return path


def record(out, unit, inputs, tools, files):
    commit, dirty = source()
    (out / 'build.json').write_text(json.dumps({
        'unit': unit, 'commit': commit, 'dirty': dirty,
        'date': datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='seconds'),
        'inputs': inputs, 'tools': tools, 'files': {f: sha256(out / f) for f in files}}, indent=1) + '\n')


def ripatch(out):
    out = new_dir(out)
    src = TOP / 'pipeline' / 'unpack' / 'ripatch.c'
    exe = out / 'ripatch'
    subprocess.run(['/usr/bin/cc', '-O2', '-Wall', '-arch', 'arm64', '-arch', 'x86_64', '-mmacosx-version-min=12.0',
                    '-o', str(exe), str(src)], check=True)
    subprocess.run(['codesign', '-f', '-s', '-', str(exe)], check=True, capture_output=True)
    cc = subprocess.run(['/usr/bin/cc', '--version'], capture_output=True, text=True).stdout.splitlines()[0]
    record(out, 'pipeline/unpack/build-tools ripatch', {'pipeline/unpack/ripatch.c': sha256(src)}, {'cc': cc},
           ['ripatch'])
    return exe


def oclp_source(out, commit, repo):
    repo = Path(repo)
    full = subprocess.run(['git', '-C', str(repo), 'rev-parse', '--verify', commit + '^{commit}'], capture_output=True,
                          text=True, check=True).stdout.strip()
    out = new_dir(out)
    with open(out / 'oclp-source.tar', 'wb') as f:
        subprocess.run(['git', '-C', str(repo), 'archive', '--format=tar', full], stdout=f, check=True)
    (out / 'LICENSE.txt').write_bytes(subprocess.run(['git', '-C', str(repo), 'show', full + ':LICENSE.txt'],
                                                     capture_output=True, check=True).stdout)
    git = subprocess.run(['git', '--version'], capture_output=True, text=True).stdout.strip()
    record(out, 'pipeline/unpack/build-tools oclp-source', {'oclp_commit': full}, {'git': git},
           ['oclp-source.tar', 'LICENSE.txt'])
    return out / 'oclp-source.tar'


def name_commit(tar, built, original):
    """`git archive COMMIT` starts with a pax global header (512 bytes) whose record is "52 comment=COMMIT\\n"; nothing
    else in the tar depends on the commit beyond its committer time. Name ORIGINAL in place of BUILT."""
    pax = b'52 comment=%s\n' % built.encode()
    if tar[:17] != b'pax_global_header' or tar[512:512 + len(pax)] != pax or len(original) != len(built):
        raise SystemExit('build-tools: git archive wrote no pax comment header for %s' % built)
    return tar[:523] + original.encode() + tar[523 + len(built):]


def oclp_rebuilt(out, upstream):
    """oclp-source without the original repository: upstream OCLP plus tools/oclp-integration/target.patch gives the
    pinned commit's tree exactly (checked); committed at the pinned commit's committer time, `git archive` stamps every
    entry with that time, and its pax header is made to name the pinned commit, so the tar equals the one made from the
    pinned commit itself. No user or system git configuration applies (tar.umask, attributes)."""
    o = runpy.run_path(str(TOP / 'tools' / 'oclp-integration' / 'make'))
    original, upstream_commit, tree = o['ORIGINAL'], o['UPSTREAM'], o['EXPECTED_TREE']
    patch = TOP / 'tools' / 'oclp-integration' / 'target.patch'
    env = dict(os.environ, GIT_CONFIG_GLOBAL='/dev/null', GIT_CONFIG_NOSYSTEM='1',
               GIT_AUTHOR_NAME='oclp-source', GIT_AUTHOR_EMAIL='oclp-source@invalid', GIT_AUTHOR_DATE=ORIGINAL_TIME,
               GIT_COMMITTER_NAME='oclp-source', GIT_COMMITTER_EMAIL='oclp-source@invalid',
               GIT_COMMITTER_DATE=ORIGINAL_TIME)
    out = new_dir(out)
    with tempfile.TemporaryDirectory(prefix='oclp-source-') as tmp:
        src = Path(tmp) / 'oclp'
        git = lambda *a: subprocess.run(['git', '-C', str(src), *a], check=True, capture_output=True, env=env).stdout
        subprocess.run(['git', 'clone', '--quiet', '--no-checkout', str(upstream or o['URL']), str(src)], check=True,
                       env=env)
        git('checkout', '--quiet', '--detach', upstream_commit)
        git('apply', '--index', str(patch))
        got = git('write-tree').decode().strip()
        if got != tree:
            raise SystemExit('build-tools: OCLP tree is %s, %s has %s' % (got, original, tree))
        commit = git('commit-tree', tree, '-p', upstream_commit, '-m', 'tree of %s' % original).decode().strip()
        tar = name_commit(git('archive', '--format=tar', commit), commit, original)
        license_ = git('show', commit + ':LICENSE.txt')
    (out / 'oclp-source.tar').write_bytes(tar)
    (out / 'LICENSE.txt').write_bytes(license_)
    git_version = subprocess.run(['git', '--version'], capture_output=True, text=True).stdout.strip()
    record(out, 'pipeline/unpack/build-tools oclp-source-rebuild',
           {'oclp_commit': original, 'upstream': upstream_commit, 'tree': tree,
            'tools/oclp-integration/target.patch': sha256(patch)},
           {'git': git_version}, ['oclp-source.tar', 'LICENSE.txt'])
    return out / 'oclp-source.tar'


def main(argv):
    if len(argv) == 2 and argv[0] == 'ripatch':
        print(ripatch(argv[1]))
        return 0
    if len(argv) in (2, 4) and argv[0] == 'oclp-source-rebuild' and argv[2:3] in ([], ['--upstream']):
        print(oclp_rebuilt(argv[1], argv[3] if len(argv) == 4 else None))
        return 0
    if len(argv) >= 4 and argv[0] == 'oclp-source' and argv[2] == '--commit':
        repo = argv[argv.index('--repo') + 1] if '--repo' in argv else TOP / 'store' / 'oclp'
        print(oclp_source(argv[1], argv[3], repo))
        return 0
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
