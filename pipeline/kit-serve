#!/usr/bin/env python3.14
"""kit-serve: serve a stick-less M27 folder (create-installer --folder DIR) to a laptop's Recovery over HTTP.

  pipeline/kit-serve DIR [--port 8770] [--bind 0.0.0.0]

GET /m27.tar streams DIR as one tar (sorted, files and folders and symbolic links as they are, nothing compressed), for
`curl -fsS http://HOST:PORT/m27.tar | tar -x -C /Volumes/M27-NET` in a NetBoot Recovery (curl and tar are there; no
Python, no rsync). The folder's own manifest (what create-installer wrote) is what the install checks before it erases
anything, so a changed or damaged transfer stops there. Read only: nothing in DIR is changed, and no other path is served.
GET /size gives the folder's byte count (for progress). Runs as the user; no root.
"""
import argparse
import http.server
import os
from pathlib import Path
import sys
import tarfile


def entries(top):
    """Every path under TOP, sorted, folders before their contents, symbolic links not followed."""
    out = []
    for d, dirs, files in os.walk(top):
        dirs.sort()
        rel = os.path.relpath(d, top)
        if rel != '.':
            out.append(rel)
        for f in sorted(files):
            out.append(os.path.normpath(os.path.join(rel, f)))
        for x in list(dirs):
            if os.path.islink(os.path.join(d, x)):
                out.append(os.path.normpath(os.path.join(rel, x)))
                dirs.remove(x)
    return out


def size(top):
    return sum(os.lstat(os.path.join(top, e)).st_size for e in entries(top))


class Writer:
    def __init__(self, wfile):
        self.wfile = wfile

    def write(self, b):
        self.wfile.write(b)
        return len(b)


def handler(top):
    class H(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            if self.path == '/size':
                body = ('%d\n' % size(top)).encode()
                self.send_response(200); self.send_header('Content-Length', str(len(body))); self.end_headers()
                self.wfile.write(body)
                return
            if self.path != '/m27.tar':
                self.send_error(404)
                return
            self.send_response(200)
            self.send_header('Content-Type', 'application/x-tar')
            self.end_headers()
            with tarfile.open(fileobj=Writer(self.wfile), mode='w|', format=tarfile.PAX_FORMAT) as t:
                for e in entries(top):
                    t.add(os.path.join(top, e), arcname=e, recursive=False)

        def log_message(self, fmt, *args):
            sys.stderr.write('kit-serve: %s %s\n' % (self.address_string(), fmt % args))
    return H


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__.split('\n')[0])
    ap.add_argument('dir')
    ap.add_argument('--port', type=int, default=8770)
    ap.add_argument('--bind', default='0.0.0.0')
    a = ap.parse_args(argv)
    top = str(Path(a.dir).resolve())
    if not os.path.isdir(top):
        sys.exit('kit-serve: %s is not a folder' % top)
    server = http.server.ThreadingHTTPServer((a.bind, a.port), handler(top))
    print('kit-serve: %s at http://%s:%d/m27.tar (%d bytes)' % (top, a.bind, a.port, size(top)), flush=True)
    server.serve_forever()


if __name__ == '__main__':
    main()
